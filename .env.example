# --- Donnees / Data ---
DATABASE_URL=postgresql+psycopg2://housat:housat@localhost:5432/housat
STAC_API_URL=https://earth-search.aws.element84.com/v1
# Backup Copernicus Data Space (optionnel, compte gratuit)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Stockage / Storage ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=housat-observations
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Alertes / Alerts ---
NTFY_TOPIC=housat-dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=alertes@housat.app

# --- Paiement / Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Detection ---
MAX_CLOUD_COVER=20
SEARCH_WINDOW_DAYS=35
CHANGE_THRESHOLD=0.12

# --- Surresolution / Super-resolution ---
# Voie DETECTION (radiometrique) : auto = SEN2SR si installe (torch), sinon repli bicubique honnete.
SR_ENGINE=auto
# Voie AFFICHAGE (PNG avant/apres) : auto = modele ONNX si SR_MODEL_PATH fourni, sinon image de detection.
DISPLAY_SR_ENGINE=auto
# Modele ONNX de surresolution d'AFFICHAGE (contrat : entree (1,3,H,W) -> sortie (1,3,4H,4W) dans [0,1]).
# Reference livree : housat/models/housat_sr_x4.onnx (EDSR-lite x4 entraine sur NAIP, domaine public US).
# VIDE = aucune SR d'affichage. Production : entrainer PAR REGION sur une HR LIBRE (voir ADR 0007).
SR_MODEL_PATH=
# Taille de tuile pour l'inference ONNX (memoire bornee) et facteur d'echelle du modele.
SR_TILE=256
SR_SCALE=4

# --- Fond visuel haute resolution / High-resolution basemap ---
# Cle Planet (NICFI) — SERVEUR UNIQUEMENT, jamais exposee au navigateur. Laisser vide desactive
# le fournisseur planet_nicfi (la carte web reste sur son fond existant).
PLANET_API_KEY=
# Mosaique NICFI datee a utiliser (mensuelle). Ex. planet_medres_normalized_analytic_2023-06_mosaic
NICFI_MOSAIC=

# --- Parcelle de demonstration / demo parcel (scripts/vv_live.ps1) ---
# Emprise bbox EPSG:4326 utilisee par le harnais V&V live. Laisser vide pour
# retomber sur la parcelle par defaut du formulaire web.
VVSITE_NAME=Ma maison
VVSITE_MIN_LON=9.70
VVSITE_MIN_LAT=4.04
VVSITE_MAX_LON=9.71
VVSITE_MAX_LAT=4.05
