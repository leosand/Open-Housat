# --- Donnees / Data ---
DATABASE_URL=postgresql+psycopg2://housat:housat@localhost:5432/housat
STAC_API_URL=https://earth-search.aws.element84.com/v1
# Backup Copernicus Data Space (optionnel, compte gratuit)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Stockage / Storage ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=housat-observations
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Alertes / Alerts ---
NTFY_TOPIC=housat-dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=alertes@housat.app

# --- Paiement / Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Detection ---
MAX_CLOUD_COVER=20
SEARCH_WINDOW_DAYS=35
CHANGE_THRESHOLD=0.12

# --- Parcelle de demonstration / demo parcel (scripts/vv_live.ps1) ---
# Emprise bbox EPSG:4326 utilisee par le harnais V&V live. Laisser vide pour
# retomber sur la parcelle par defaut du formulaire web.
VVSITE_NAME=Ma maison
VVSITE_MIN_LON=9.70
VVSITE_MIN_LAT=4.04
VVSITE_MAX_LON=9.71
VVSITE_MAX_LAT=4.05
